# syntax=docker/dockerfile:1.7

ARG BUNNYLAND_WEB_IMAGE=ghcr.io/thalismind/bunnyland-web@sha256:7ef0399d89c9550228bc3da83820864955de6dcfccdd8080bd0122da0e14ce05

FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS build

WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
RUN npm audit --audit-level=high

COPY web/index.html web/admin.html web/player.html web/nginx.conf web/vite.config.ts web/tsconfig.json ./
COPY web/src ./src
COPY web/public ./public
COPY web/scripts ./scripts

ENV BUNNYLAND_3D_BASE=/3d/
RUN npm run build

FROM build AS test

COPY web/test ./test
RUN mkdir -p /reports
CMD ["node", "--test", "--test-reporter=junit", "--test-reporter-destination=/reports/web.xml"]

FROM mcr.microsoft.com/playwright/python:v1.56.0-noble@sha256:a7f6cf3ae520c9d670ad956572c13747ed5abdbba5123a01526f873ed1662528 AS browser-test

WORKDIR /app/web
RUN python -m pip install --no-cache-dir playwright==1.56.0
COPY --from=build /app/web/dist ./dist
COPY --from=build /app/web/node_modules/axe-core/axe.min.js ./node_modules/axe-core/axe.min.js
COPY web/scripts ./scripts
CMD ["./scripts/playwright-world-3d"]

FROM ${BUNNYLAND_WEB_IMAGE} AS runtime

ENV BUNNYLAND_3D_URL=/3d/player.html

COPY --from=build /app/web/dist /usr/share/nginx/html/3d
